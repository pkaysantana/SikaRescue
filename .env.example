# SikaRescue configuration. Copy to `.env` and fill in locally. NEVER commit `.env`.
# All payment rails, balances and transactions in this project are SYNTHETIC demo data.

# --- Core (Phase 2+) ---------------------------------------------------------
# Simulated latency (seconds) of the synthetic payout provider call during recovery execution.
SIKARESCUE_PAYOUT_LATENCY_SECONDS=0.5
# No provider answer within this window after dispatch => UNKNOWN outcome => manual review.
SIKARESCUE_PAYOUT_TIMEOUT_SECONDS=30

# --- Compute backend (Phase 3/4) ----------------------------------------------
# local | modal
SIKARESCUE_COMPUTE_BACKEND=local
# Seeded synthetic reliability simulation.
SIKARESCUE_SIMULATION_SEED=10421
# quick (3 scenarios x 2,000 trials) | stress (6 scenarios x 50,000 trials).
# Leave unset: stress for modal, quick for local.
# SIKARESCUE_SIMULATION_WORKLOAD=
# SIKARESCUE_SIMULATION_TRIALS_PER_SCENARIO=
# Modal: deploy once with `uv run modal deploy -m sikarescue.compute.modal_app`.
# Timeout / failure => local fallback, recorded in the plan's compute summary.
SIKARESCUE_MODAL_TIMEOUT_SECONDS=15
SIKARESCUE_MODAL_SHARDS_PER_SCENARIO=2

# Modal auth is normally configured via `modal token new` (stored outside the repo).
# Only set these for CI / non-interactive environments.
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# --- Pydantic AI advice layer (Phase 5) ----------------------------------------
# deterministic (default, never calls a model) | pydantic (agent explains the plan; any model
# failure => orchestrator=deterministic_fallback and the recovery continues unchanged).
SIKARESCUE_AGENT_MODE=deterministic
# gateway/<provider>:<model> routes through Pydantic AI Gateway. Direct strings such as
# anthropic:... / openai:... / google:... also work (NOT via Gateway) with that SDK's own key.
SIKARESCUE_AGENT_MODEL=gateway/anthropic:claude-haiku-4-5
# Optional: a provider slug or gateway-endpoint slug from Logfire -> Gateway (e.g. a BYOK
# provider, or an endpoint with failover). Unset = the provider's default route.
# SIKARESCUE_GATEWAY_ROUTE=
# Short, bounded model calls for a live demo.
SIKARESCUE_AGENT_REQUEST_TIMEOUT_SECONDS=20
SIKARESCUE_AGENT_RUN_TIMEOUT_SECONDS=60
SIKARESCUE_AGENT_MAX_MODEL_REQUESTS=8

# --- Pydantic AI Gateway (Logfire -> Gateway) ------------------------------------
# API key from Logfire -> Gateway -> API Keys (pylf_v..._<region>_...). The base URL is
# inferred from the key's region; set it only for self-hosted / non-default regions.
# PYDANTIC_AI_GATEWAY_API_KEY=
# PYDANTIC_AI_GATEWAY_BASE_URL=https://gateway-eu.pydantic.dev/proxy
# Guardrail demo only: a route on which you enabled a guardrail (redact or block).
# SIKARESCUE_GATEWAY_GUARDRAIL_ROUTE=

# --- Logfire -----------------------------------------------------------------------
# Write token (Logfire -> project -> Settings -> Write tokens). Unset = local spans only.
# LOGFIRE_TOKEN=
# Read token, used only by scripts/agent_smoke.py to VERIFY the trace arrived.
# LOGFIRE_READ_TOKEN=
SIKARESCUE_ENVIRONMENT=dev
# Model-facing content is allowlisted (no PII), so it is safe to record in traces.
SIKARESCUE_LOGFIRE_CAPTURE_MODEL_CONTENT=true
